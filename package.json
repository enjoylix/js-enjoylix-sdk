{
  "name": "@enjoylix/sdk",
  "version": "1.0.9",
  "description": "Enjoylix SDK for web partners (non-Unity). Authentication, Purchase, Age verification, Attribution.",
  "license": "ISC",
  "author": {
    "name": "Pochemu LTD",
    "email": "info@pochemultd.com",
    "url": "https://pochemultd.com"
  },
  "keywords": [
    "enjoylix",
    "login",
    "attribution",
    "payment",
    "age verification"
  ],
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
